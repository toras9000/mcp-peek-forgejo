@HostAddress = http://localhost:5000

POST {{HostAddress}}/
Accept: application/json, text/event-stream
Content-Type: application/json
Authorization: Bearer secret-keyword-level-2
MCP-Protocol-Version: 2025-11-25

{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
        "name": "get_server_version"
    }
}

