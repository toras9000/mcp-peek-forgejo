{
  "Urls": "http://*:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedSettings": {
    "ClearDefaultNetworks": true,
    "ForwardedHeaders": "XForwardedFor, XForwardedProto",
    "ForwardLimit": 1,
    "KnownNetworks": [ "192.168.1.0/24" ],
    "KnownProxies": [ "192.168.1.100" ],
    "AllowedHosts": [ "*.myserver.localhost" ],
    "RequireHeaderSymmetry": true,
    "ForwardedForHeaderName": "X-Forwarded-For",
    "ForwardedHostHeaderName": "X-Forwarded-Host",
    "ForwardedProtoHeaderName": "X-Forwarded-Proto",
    "ForwardedPrefixHeaderName": "X-Forwarded-Prefix"
  },
  "Mcp": {
    "Service": {
      "Secrets": {
        "Level1": "secret-keyword-level-1",
        "Level2": "secret-keyword-level-2"
      }
    },
    "Forgejo": {
      "InstanceName": "My Forgejo",
      "Url": "http://localhost:8000",
      "ApiToken": "aaaabbbbccccddddeeeeffffgggghhhhiiiijjjj"
    },
    "Repository": {
      "IncludePrivate": false
    }
  }
}