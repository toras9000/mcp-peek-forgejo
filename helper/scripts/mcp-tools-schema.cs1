#!/usr/bin/env -S dotnet run --file 
#:package Spectre.Console@0.57.2
#:package Spectre.Console.Json@0.57.2
#:package Lestaly.General@0.148.0
#:package ModelContextProtocol.Core@2.4.0
#:property PublishAot=false
using System.Text.Encodings.Web;
using System.Text.Json;
using System.Text.Json.Serialization;
using System.Text.Json.Serialization.Metadata;
using Lestaly;
using ModelContextProtocol.Client;
using Spectre.Console;
using Spectre.Console.Json;

return await Paved.ProceedAsync(async () =>
{
    const string DefaultServer = "http://localhost:5000";
    const string DefaultToken = "secret-keyword-level-2";

    var context = await createContextAsync(DefaultServer, DefaultToken);

    var toolTargets = new List<SchemeTarget>();
    foreach (var tool in context.Tools)
    {
        toolTargets.Add(new(tool, Caption: $"{tool.Name} (Input)", tool.JsonSchema));
        if (tool.ReturnJsonSchema != null) toolTargets.Add(new(tool, Caption: $"{tool.Name} (Output)", tool.ReturnJsonSchema.Value));
    }

    var toolSelection = new SelectionPrompt<SchemeTarget>()
        .Title("Select tool")
        .AddChoices(toolTargets)
        .UseConverter(t => t.Caption)
        ;

    while (true)
    {
        AnsiConsole.WriteLine();
        var target = await AnsiConsole.PromptAsync(toolSelection);

        AnsiConsole.MarkupLineInterpolated($"Tool: [DarkOrange][bold]{target.Caption}[/][/]");
        AnsiConsole.MarkupLineInterpolated($"Description: {target.Tool.Description}");
        AnsiConsole.Write(new Panel(new JsonText(context.ToJsonString(target.Schema))).Header("Schema"));
    }
});

async ValueTask<InspectContext> createContextAsync(string defaultServer, string defaultToken)
{
    while (true)
    {
        Console.WriteLine($"Enter MCP Server (default: {defaultServer})");
        Console.Write(">");
        var server = Console.ReadLine().OmitWhite() ?? defaultServer;

        Console.WriteLine($"Enter Auth Token (default: {defaultToken})");
        Console.Write(">");
        var token = Console.ReadLine().OmitWhite() ?? defaultToken;

        Console.WriteLine($"Connect to {server} ...");
        var client = default(McpClient);
        try
        {
            var options = new HttpClientTransportOptions() { Endpoint = new(server) };
            if (!string.IsNullOrWhiteSpace(token))
            {
                options.AdditionalHeaders = new Dictionary<string, string>()
                {
                    ["Authorization"] = $"Bearer {token}",
                };
            }
            var transport = new HttpClientTransport(options);
            client = await McpClient.CreateAsync(transport);
        }
        catch (Exception ex)
        {
            AnsiConsole.MarkupLineInterpolated($"[red]Connection error: {ex.Message}[/]");
            AnsiConsole.WriteLine();
            continue;
        }

        try
        {
            var tools = await client.ListToolsAsync();
            if (tools.Count <= 0)
            {
                Console.WriteLine($"No tools");
                AnsiConsole.WriteLine();
                await client.DisposeAsync();
                continue;
            }

            return new InspectContext(client, tools);
        }
        catch (Exception ex)
        {
            AnsiConsole.MarkupLineInterpolated($"[red]List error: {ex.Message}[/]");
            AnsiConsole.WriteLine();
            await client.DisposeAsync();
            continue;
        }
    }
}

record SchemeTarget(McpClientTool Tool, string Caption, JsonElement Schema);

class InspectContext
{
    public InspectContext(McpClient client, IList<McpClientTool> tools)
    {
        this.Client = client;
        this.Tools = tools;

        this.JsonOptions = new JsonSerializerOptions();
        this.JsonOptions.ReadCommentHandling = JsonCommentHandling.Skip;
        this.JsonOptions.Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping;
        this.JsonOptions.DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull;
        this.JsonOptions.NumberHandling = JsonNumberHandling.AllowReadingFromString | JsonNumberHandling.AllowNamedFloatingPointLiterals;
        this.JsonOptions.PropertyNameCaseInsensitive = true;
        this.JsonOptions.TypeInfoResolver = new DefaultJsonTypeInfoResolver();
        this.JsonOptions.MakeReadOnly();
    }

    public McpClient Client { get; }
    public IList<McpClientTool> Tools { get; }
    public JsonSerializerOptions JsonOptions { get; }

    public string ToJsonString<T>(T value) => JsonSerializer.Serialize(value, this.JsonOptions);
}
